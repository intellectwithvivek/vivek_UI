{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "node scripts/gen-registry.mjs && next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "build:all": "pnpm --filter @the_viveksingh/vivek-ui build && node scripts/gen-registry.mjs && next build",
    "dev:all": "pnpm --filter @the_viveksingh/vivek-ui build && node scripts/gen-registry.mjs && next dev --port 3100",
    "gen:registry": "node scripts/gen-registry.mjs"
  },
  "dependencies": {
    "@the_viveksingh/vivek-ui": "workspace:*",
    "next": "^16.3.2",
    "react": "19",
    "react-dom": "19",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
