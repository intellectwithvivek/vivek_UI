{
  "name": "vivek-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "size": "pnpm --filter @the_viveksingh/vivek-ui size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "gen:exports": "node scripts/gen-exports.mjs",
    "check:refs": "node scripts/strip-internal-refs.mjs --check",
    "gen:readme": "node scripts/gen-readme-catalog.mjs",
    "check:readme": "node scripts/gen-readme-catalog.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
