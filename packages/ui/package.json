{
  "name": "@the_viveksingh/vivek-ui",
  "version": "0.5.0",
  "description": "A free React component library with zero runtime dependencies: 109 accessible, server-safe components and 10 SVG charts. Layout, forms, overlays, page sections, AI chat, DataTable. One install, one CSS import, no Tailwind, no config. React 18/19 and Next.js.",
  "license": "MIT",
  "author": {
    "name": "Vivek Kumar Singh",
    "email": "intellectwithvivek@gmail.com",
    "url": "https://vivekkumarsingh.in"
  },
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/theviveksingh"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/intellectwithvivek"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts/index.d.ts",
        "default": "./dist/charts/index.js"
      },
      "require": {
        "types": "./dist/charts/index.d.cts",
        "default": "./dist/charts/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./print.css": "./dist/print.css",
    "./charts.css": "./dist/charts.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "charts": [
        "./dist/charts/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectwithvivek/vivek_UI.git",
    "directory": "packages/ui"
  },
  "homepage": "https://ui.vivekkumarsingh.in",
  "bugs": {
    "url": "https://github.com/intellectwithvivek/vivek_UI/issues"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "design-system",
    "nextjs",
    "react-server-components",
    "zero-dependency",
    "css-variables",
    "accessible",
    "typescript",
    "charts",
    "datatable",
    "chat-ui",
    "ai-chat",
    "tailwind-alternative",
    "shadcn-alternative",
    "headless",
    "wcag",
    "aria"
  ],
  "scripts": {
    "build": "node ../../scripts/gen-exports.mjs --check && node ../../scripts/build-js.mjs && node ../../scripts/fix-dist-specifiers.mjs && pnpm build:css && node ../../scripts/check-directives.mjs",
    "build:css": "lightningcss --bundle --minify src/styles/entry.css -o dist/styles.css && lightningcss --bundle --minify src/charts/styles.css -o dist/charts.css && lightningcss --bundle --minify src/styles/print.css -o dist/print.css",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node ../../scripts/size-snapshot.mjs --check",
    "size:update": "node ../../scripts/size-snapshot.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "name": "Button only",
      "path": "dist/index.js",
      "import": "{ Button }",
      "limit": "3 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    },
    {
      "name": "Modal (focus trap + scroll lock + portal)",
      "path": "dist/index.js",
      "import": "{ Modal }",
      "limit": "6 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    },
    {
      "name": "A landing page (Hero+Features+Pricing+FAQ+CTA+Footer)",
      "path": "dist/index.js",
      "import": "{ Hero, FeatureGrid, Pricing, FAQ, CTA, Footer }",
      "limit": "8 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    },
    {
      "name": "All charts",
      "path": "dist/charts/index.js",
      "import": "*",
      "limit": "12 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    },
    {
      "name": "Whole core library",
      "path": "dist/index.js",
      "import": "*",
      "limit": "72 kB",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ]
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "jsqr": "1.4.0",
    "lightningcss-cli": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
